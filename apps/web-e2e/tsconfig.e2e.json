{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "rootDir": ".",
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "playwright.config.mts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "test-results",
    "playwright-report",
    "node_modules"
  ]
}
